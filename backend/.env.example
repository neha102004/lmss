# Copy to .env (e.g. copy .env.example .env)
# For quick start with SQLite: run "npm run db:use-sqlite" — it will set DATABASE_URL for you.

# Database: use SQLite (set by db:use-sqlite) or Aiven MySQL below
# DATABASE_URL="file:./prisma/dev.db"
DATABASE_URL="mysql://user:password@your-aiven-host:port/defaultdb?sslmode=require"

# JWT secrets (use long random strings in production)
JWT_ACCESS_SECRET="your-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Server
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Hugging Face API key (for chatbot)
# Get one at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="hf_xxxxxxxxxxxxxxxx"
