# Copy to .env and fill in your values

# Aiven MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="mysql://user:password@your-aiven-host:port/defaultdb?sslmode=require"

# JWT secrets (use long random strings in production)
JWT_ACCESS_SECRET="your-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Server
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Hugging Face API key (for chatbot)
# Get one at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="hf_xxxxxxxxxxxxxxxx"
